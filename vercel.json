{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "PORT=5000 BASE_PATH=/ pnpm run build",
  "outputDirectory": "artifacts/pyx-energia/dist/public",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.pyxenergia.com" }],
      "destination": "https://pyxenergia.com/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/painel", "destination": "/spa.html" },
    { "source": "/sign-in", "destination": "/spa.html" },
    { "source": "/sign-in/(.*)", "destination": "/spa.html" },
    { "source": "/sign-up", "destination": "/spa.html" },
    { "source": "/sign-up/(.*)", "destination": "/spa.html" }
  ]
}
